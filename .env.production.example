# ══════════════════════════════════════════════════════════════════════════
# AskforWrite AI Company OS — Production Environment Template
# ══════════════════════════════════════════════════════════════════════════
# INSTRUCTIONS:
#   1. Copy this file to .env:  cp .env.production.example .env
#   2. Fill in ALL values marked "REQUIRED"
#   3. NEVER commit .env to version control
#   4. For Docker: pass as --env-file or use Docker secrets
# ══════════════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────────────
APP_ENV=production
APP_PORT=8000
UVICORN_WORKERS=4

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_DB=askforwrite_os
POSTGRES_USER=askforwrite
POSTGRES_PASSWORD=REQUIRED_minimum_24_characters
POSTGRES_PORT=5432

# ── Database URL (used by os_gateway) ──────────────────────────────────────
# For Docker Compose: host is the service name 'postgres'
# For external PG:    use your host:port
DATABASE_URL=postgresql+psycopg://askforwrite:REQUIRED_PASSWORD@postgres:5432/askforwrite_os

# ── API Authentication & Security ──────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MANAGER_API_KEY=REQUIRED_minimum_32_characters
OWNER_API_KEY=REQUIRED_minimum_32_characters
JWT_SECRET_KEY=REQUIRED_minimum_32_characters_for_jwt_and_session_signing
AUTH_SECRET_KEY=REQUIRED_minimum_32_characters_for_jwt_and_session_signing

# ── AFW DirectPay — Sovereign Zero-Fee Payment Rails (0% Commission) ────────
AFW_MERCHANT_UPI_VPA=askforwrite@okhdfcbank
AFW_MERCHANT_NAME=AskforWrite AI Solutions
AFW_MERCHANT_EVM_WALLET=0xAF3896582aBE3f305c4EB7A1e1Bf498c8942918B
AFW_MERCHANT_SOL_WALLET=AFW4V5aJk9QZ9wP8Uq1rGkM5yXoB2cK3mR4f1a2s3d4e
WEB3_RPC_URL=https://polygon-rpc.com
AFW_BANK_BENEFICIARY=AskforWrite AI Solutions
AFW_BANK_NAME=HDFC Bank Ltd
AFW_BANK_ACCOUNT_NUMBER=50200088921455
AFW_BANK_ACCOUNT_TYPE=Current Account
AFW_BANK_IFSC=HDFC0000240
AFW_BANK_SWIFT=HDFCINBBXXX
AFW_BANK_BRANCH=Indiranagar Branch, Bengaluru, Karnataka, India

# ── CORS Allowed Origins (comma-separated) ─────────────────────────────────
# Leave empty to deny all cross-origin requests in production.
ALLOWED_ORIGINS=https://dashboard.askforwrite.in

# ── Google Gemini AI ───────────────────────────────────────────────────────
GOOGLE_API_KEY=REQUIRED_your_google_ai_api_key
GEMINI_MODEL=gemini-2.0-flash

# ── LangSmith Tracing (optional but recommended) ───────────────────────────
LANGSMITH_API_KEY=OPTIONAL_your_langsmith_api_key
LANGSMITH_PROJECT=askforwrite-company-os

# ── AskforWrite Native Field Force Engine ─────────────────────────────────
FIELD_FORCE_BASE_URL=https://fieldforce.askforwrite.com
FIELD_FORCE_SERVICE_TOKEN=REQUIRED_if_using_field_force_integration

# ── ASK4 Webhook Security ───────────────────────────────────────────────────
ASK4_WEBHOOK_SECRET=REQUIRED_minimum_32_characters_for_hmac_verification

# ── Payment Gateways (Razorpay & PayPal) ───────────────────────────────────
# Default Provider: "razorpay" (INR) or "paypal" (USD)
PAYMENT_PROVIDER=razorpay

# Razorpay Configuration (INR transactions)
RAZORPAY_KEY_ID=REQUIRED_your_razorpay_key_id
RAZORPAY_KEY_SECRET=REQUIRED_your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=REQUIRED_your_razorpay_webhook_secret
RAZORPAY_PAYMENT_LINK=https://razorpay.me/@askforwrite

# PayPal Configuration (Global / USD transactions)
PAYPAL_CLIENT_ID=REQUIRED_your_paypal_client_id
PAYPAL_CLIENT_SECRET=REQUIRED_your_paypal_client_secret
PAYPAL_WEBHOOK_ID=REQUIRED_your_paypal_webhook_id
PAYPAL_WEBHOOK_SECRET=REQUIRED_your_paypal_webhook_secret
PAYPAL_MODE=live
PAYPAL_PAYMENT_LINK=https://paypal.me/ask4write

# ── Outbound Outreach & SMTP (Owner HITL Gated) ─────────────────────────────
# Options: "mock" (for safe dry-run) or "smtp" (for live email delivery)
OUTREACH_DISPATCH_PROVIDER=smtp
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=REQUIRED_your_smtp_username
SMTP_USER=REQUIRED_your_smtp_username
SMTP_PASSWORD=REQUIRED_your_smtp_app_password
OUTREACH_FROM_EMAIL=info@askforwrite.in

# ── 4-Site WordPress Publishing Bridge ──────────────────────────────────────
# askforwrite.in, theaiscene.in, careersathi.in, edutechguide.in
WP_SITE_URL=https://askforwrite.in
WP_USERNAME=REQUIRED_your_wp_username
WP_APP_PASSWORD=REQUIRED_your_wp_app_password

# ── Live SMB Search Query Enrichment (Optional) ─────────────────────────────
# Optional: falls back to curated regional SMB directory if unset
SERPER_API_KEY=
GOOGLE_PLACES_API_KEY=

# ── Observability & Monitoring (Sentry & Logging) ───────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
LOG_LEVEL=INFO
