# ══════════════════════════════════════════════════════════════════════════
# AskforWrite AI Company OS — Production Environment Template
# ══════════════════════════════════════════════════════════════════════════
# INSTRUCTIONS:
#   1. Copy this file to .env:  cp .env.production.example .env
#   2. Fill in ALL values marked "REQUIRED"
#   3. NEVER commit .env to version control
#   4. For Docker: pass as --env-file or use Docker secrets
# ══════════════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────────────
APP_ENV=production
APP_PORT=8000
UVICORN_WORKERS=4

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_DB=askforwrite_os
POSTGRES_USER=askforwrite
POSTGRES_PASSWORD=REQUIRED_minimum_24_characters
POSTGRES_PORT=5432

# ── Database URL (used by os_gateway) ──────────────────────────────────────
# For Docker Compose: host is the service name 'postgres'
# For external PG:    use your host:port
DATABASE_URL=postgresql+psycopg://askforwrite:REQUIRED_PASSWORD@postgres:5432/askforwrite_os

# ── API Authentication ──────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MANAGER_API_KEY=REQUIRED_minimum_32_characters
OWNER_API_KEY=REQUIRED_minimum_32_characters

# ── CORS Allowed Origins (comma-separated) ─────────────────────────────────
# Leave empty to deny all cross-origin requests in production.
ALLOWED_ORIGINS=https://dashboard.askforwrite.in

# ── Google Gemini AI ───────────────────────────────────────────────────────
GOOGLE_API_KEY=REQUIRED_your_google_ai_api_key
GEMINI_MODEL=gemini-2.0-flash

# ── LangSmith Tracing (optional but recommended) ───────────────────────────
LANGSMITH_API_KEY=OPTIONAL_your_langsmith_api_key
LANGSMITH_PROJECT=askforwrite-company-os

# ── Field Force Integration (Unolo) ────────────────────────────────────────
FIELD_FORCE_BASE_URL=https://api.unolo.com
FIELD_FORCE_SERVICE_TOKEN=REQUIRED_if_using_field_force_integration

# ── ASK4 Webhook Security ───────────────────────────────────────────────────
ASK4_WEBHOOK_SECRET=REQUIRED_minimum_32_characters_for_hmac_verification
