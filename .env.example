# ─────────────────────────────────────────────────────────────────────────────
# AskforWrite AI Company OS — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────

# 1. Core Mode & Security Keys
APP_ENV=development
APP_PORT=8000
UVICORN_WORKERS=4
OWNER_API_KEY=your-strong-32-char-owner-secret-key
MANAGER_API_KEY=your-strong-32-char-manager-secret-key
JWT_SECRET_KEY=your-strong-jwt-signing-secret
AUTH_SECRET_KEY=your-strong-jwt-signing-secret

# 2. AFW DirectPay — Sovereign Zero-Fee Payment Rails (0% Commission)
AFW_MERCHANT_UPI_VPA=ask4write@icici
AFW_MERCHANT_NAME=AskforWrite AI Solutions
AFW_MERCHANT_EVM_WALLET=0xYourPolygonOrBaseWalletAddress
AFW_MERCHANT_SOL_WALLET=YourSolanaWalletAddress
WEB3_RPC_URL=https://polygon-rpc.com
AFW_BANK_BENEFICIARY=AskforWrite AI Solutions
AFW_BANK_NAME=ICICI Bank Ltd
AFW_BANK_ACCOUNT_NUMBER=YourBankAccountNumber
AFW_BANK_ACCOUNT_TYPE=Current Account
AFW_BANK_IFSC=YourBankIFSC
AFW_BANK_SWIFT=YourBankSWIFT
AFW_BANK_BRANCH=YourBankBranch

# 3. Gemini AI Brain & Live Search (Optional — Keyless DuckDuckGo Active by Default)
GEMINI_API_KEY=your-gemini-api-key
SERPER_API_KEY=
GOOGLE_PLACES_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 4. Outbound Email (Hostinger SMTP) & 4-Site WordPress Publishing
OUTREACH_DISPATCH_PROVIDER=smtp
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@askforwrite.in
SMTP_USERNAME=info@askforwrite.in
SMTP_PASSWORD=your-smtp-password
OUTREACH_FROM_EMAIL=info@askforwrite.in
WP_SITE_URL=https://askforwrite.in
WP_USERNAME=your-wp-username
WP_APP_PASSWORD=your-wp-application-password

# 5. Database & Multi-Tenant Isolation
DATABASE_URL=sqlite:///./company_os.db
ALLOW_SQLITE_PRODUCTION=true
POSTGRES_DB=askforwrite_os
POSTGRES_USER=askforwrite
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_PORT=5432

# 6. Legacy Aggregators (Razorpay & PayPal Live Fallbacks)
PAYMENT_PROVIDER=sovereign
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PAYMENT_LINK=https://razorpay.me/@askforwrite
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_PAYMENT_LINK=https://paypal.me/ask4write